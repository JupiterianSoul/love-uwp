+#ifdef LOVE_WINDOWS_UWP
+	luaJIT_setmode(L, 0, LUAJIT_MODE_ENGINE | LUAJIT_MODE_OFF);
+#endif
+
 	// LuaJIT-specific setup needs to be done as early as possible - before
 	// get_app_arguments because that loads external library code. This is also
 	// loaded inside love's Lua threads. Note that it doesn't use the love table.
@@ -270,6 +329,27 @@ int main(int argc, char **argv)
 		return 1;
 	}
 
+#ifdef LOVE_WINDOWS_UWP
+	love_uwp_setup_view();
+	SDL_SetHint(SDL_HINT_WINRT_HANDLE_BACK_BUTTON, "1");
+
+	std::vector<char *> uwp_argv(argv, argv + argc);
+	std::string uwp_fused = "--fused";
+	std::string uwp_game;
+	if (argc <= 1)
+	{
+		uwp_game = uwp_find_game();
+		if (!uwp_game.empty())
+		{
+			uwp_argv.push_back(&uwp_fused[0]);
+			uwp_argv.push_back(&uwp_game[0]);
+		}
+	}
+	argc = (int) uwp_argv.size();
+	uwp_argv.push_back(nullptr);
+	argv = uwp_argv.data();
+#endif
+
 	int retval = 0;
 	DoneAction done = DONE_QUIT;
 
