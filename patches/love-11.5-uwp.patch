+#ifdef LOVE_WINDOWS_UWP
+
+#include <string>
+#include <vector>
+#include <sys/stat.h>
+
+extern "C" void love_uwp_setup_view(void);
+
+static bool uwp_path_exists(const std::string &path)
+{
+	int len = MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, nullptr, 0);
+	if (len <= 0)
+		return false;
+	std::wstring wpath(len, L'\0');
+	MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, &wpath[0], len);
+	struct _stat64 st;
+	return _wstat64(wpath.c_str(), &st) == 0;
+}
+
+static std::string uwp_find_game()
+{
+	const char *dirs[] = {
+		SDL_WinRTGetFSPathUTF8(SDL_WINRT_PATH_LOCAL_FOLDER),
+		SDL_WinRTGetFSPathUTF8(SDL_WINRT_PATH_INSTALLED_LOCATION),
+	};
+	const char *names[] = {"game.love", "game"};
+
+	for (const char *dir : dirs)
+	{
+		if (dir == nullptr)
+			continue;
+		for (const char *name : names)
+		{
+			std::string path = std::string(dir) + "\\" + name;
+			if (uwp_path_exists(path))
+				return path;
+		}
+	}
+
+	const char *installed = SDL_WinRTGetFSPathUTF8(SDL_WINRT_PATH_INSTALLED_LOCATION);
+	if (installed != nullptr)
+	{
+		std::string path = std::string(installed) + "\\nogame";
+		if (uwp_path_exists(path))
+			return path;
+	}
+
+	return "";
+}
+
+#endif // LOVE_WINDOWS_UWP
+
 #ifdef LOVE_LEGENDARY_APP_ARGV_HACK
 
